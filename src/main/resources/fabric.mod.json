{
    "schemaVersion": 1,
    "id": "bbs-aaaddon",
    "version": "${version}",
    "name": "BBS AAAddon",
    "description": "BBS Addon for AAAparticle",
    "authors": [
        "Diobede the sigma",
        "ElGatoPro300"
    ],
    "contact": {
        "homepage": "",
        "sources": ""
    },
    "license": "CC0-1.0",
    "icon": "assets/bbs-aaaddon/icon.png",
    "environment": "*",
    "mixins": [
        {
            "config": "bbs-aaaddon.client.mixins.json",
            "environment": "client"
        }
    ],
    "entrypoints": {
        "main": [
            "diobede.bbsaaa.BBSAAaddon"
        ],
        "bbs-addon": [
            {
                "adapter": "bbsaaa-host",
                "value": "diobede.bbsaaa.addon.BbsAAAddon"
            }
        ],
        "bbs-client-addon": [
            {
                "adapter": "bbsaaa-host",
                "value": "diobede.bbsaaa.BbsAAClientAddon"
            }
        ]
    },
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "=${minecraft_version}",
        "java": ">=${java_version}",
        "fabric-api": "*",
        "bbs": ">=3.0-beta-7",
        "aaa_particles": "*"
    },
    "languageAdapters": {
        "bbsaaa-host": "diobede.bbsaaa.compat.host.HostLanguageAdapter"
    }
}
